// fors_k32_a8.kiss
// Purpose: FORS-style few-time signature with SHA2 leaves (k=32 trees of 2^8 leaves), one PROOF per revealed secret
// State ports: 30 revealed secrets, 31 tree roots, 32 digest, 33 key hash, 40+t MMR proof for tree t
// Node 1.0.45.15 (lab peer 9101, RPC 9105), runscript dry run. Measurements (receipt = measure/receipts/<name>.json):
//   fors_k32_a8: 625 instructions, success=true (FORS-style k=32 a=8, PROOF per revealed secret)
// Script size: 3193 characters; state data in the measured call: 12756 bytes. Body below is comment-free (deploy form).

LET d=STATE(32)
LET rs=STATE(31)
LET sc=STATE(30)
ASSERT SHA2(rs) EQ STATE(33)
ASSERT PROOF(SHA2(SUBSET(0 32 sc)) NUMBER(SUBSET(0 1 d)) SUBSET(0 32 rs) 32640 STATE(40))
ASSERT PROOF(SHA2(SUBSET(32 64 sc)) NUMBER(SUBSET(1 2 d)) SUBSET(32 64 rs) 32640 STATE(41))
