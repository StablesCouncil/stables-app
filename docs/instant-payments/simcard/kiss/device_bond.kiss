// device_bond.kiss
// Device bond: freeze by proof of cheating or by claim, withdrawal with delay, root renewal, retirement.
// Measured: see measure/receipts/covenant-branches.json (node 1.0.45.15 jar, in-process) and templateChecks there.
// Placeholders used in the measured copy: STAMP/USDW token ids, BURN/NOTES/POOL addresses and the helper body hash are random test values.
//   C2_bond_freeze_by_claim: 97 instructions, success=true (expected true)
//   bond_freeze_by_cheat_proof: 158 instructions, success=true (expected true)
//   NEG_bond_freeze_same_secret_twice: 57 instructions, success=false (expected false)
//   bond_withdraw_request: 42 instructions, success=true (expected true)
//   NEG_bond_withdraw_request_unsigned: 19 instructions, success=false (expected false)
//   bond_withdraw_after_delay: 39 instructions, success=true (expected true)
//   NEG_bond_withdraw_too_early: 31 instructions, success=false (expected false)
//   bond_renew_add_root: 85 instructions, success=true (expected true)
//   NEG_bond_renew_replaces_root: 64 instructions, success=false (expected false)
//   bond_abandoned_retirement: 39 instructions, success=true (expected true)

LET op=STATE(9)
IF op EQ 20 THEN
LET i=STATE(12)
LET c=STATE(13)
LET w=i-c*51
LET a=STATE(10)
LET b=STATE(11)
LET tt=SHA2(SUBSET(0 16 SHA2(a)))^SHA2(SUBSET(0 16 SHA2(b)))
ASSERT CONCAT(0x01 tt) EQ CONCAT(0x01 SUBSET(w*32 w*32+32 STATE(14)))
LET v=i%128
LET q=8*(15-FLOOR(v/8))+(v%8)
ASSERT  NOT BITGET(a q)
ASSERT BITGET(b q)
ASSERT SHA2(CONCAT(0x01 STATE(14))) EQ SUBSET(c*32 c*32+32 STATE(15))
ASSERT SHA2(CONCAT(0x01 STATE(15))) EQ STATE(16)
ASSERT PROOF(STATE(16) 0 PREVSTATE(120+STATE(17)) STATE(18) STATE(19))
ASSERT SAMESTATE(120 129)
ASSERT STATE(130) LTE @BLOCK
ASSERT STATE(130) GTE @BLOCK-20
ASSERT STATE(131) EQ @AMOUNT
ASSERT STATE(139) EQ 0
RETURN VERIFYOUT(0 0xDC67DDAF097AF0EEC4A650E4ACC43FF2BD8AD285062A965ADF55EEF6081E2EAA @AMOUNT @TOKENID TRUE)
ENDIF IF op EQ 4 THEN
ASSERT GETINTOK(0) EQ 0x98DB51DCCF3F6CC7EBA4F239F3D23F3473E8971668945B80CBB8BCEAB97F85DF
ASSERT GETINADDR(0) EQ ADDRESS([LET h=]+STRING(SHA2(STATE(230)))+[
LET rec=0xD40E26AA151812A352576B20FB81DAA332B071909ABF3D7B752A07524EC3F81F
LET s=STATE(230)
ASSERT SHA2(s) EQ h
ASSERT @INPUT EQ 0
ASSERT GETINADDR(1) EQ rec
LET r=STATE(200)
ASSERT SUBSET(0 32 r) EQ SUBSET(0 32 s)
LET j=NUMBER(SUBSET(32 33 s))
LET o=32+64*(j-1)
ASSERT SUBSET(o o+32 r) EQ SUBSET(33 65 s)
ASSERT SUBSET(o-32 o r) EQ SUBSET(65 97 s)
IF o+64 LT LEN(r) THEN
ASSERT SUBSET(o+32 o+64 r) NEQ SUBSET(97 129 s)
ENDIF ASSERT STATE(231) EQ SUBSET(161 193 s)
RETURN VERIFYOUT(0 0xCA777B9FD6F1E79EEE12D469E48FAB00AEC95CBDDB2508A88C89BAB0667062ED 1 @TOKENID FALSE)])
ASSERT @INPUT EQ 2
ASSERT PREVSTATE(120+STATE(232)) EQ STATE(231)
ASSERT SAMESTATE(120 129)
ASSERT STATE(130) LTE @BLOCK
ASSERT STATE(130) GTE @BLOCK-20
ASSERT STATE(131) EQ @AMOUNT
ASSERT STATE(139) EQ 1
ASSERT STATE(142) EQ SHA2(STATE(230))
ASSERT STATE(140) EQ SUBSET(129 161 STATE(230))
ASSERT STATE(141) EQ STATE(202)
RETURN VERIFYOUT(2 0xDC67DDAF097AF0EEC4A650E4ACC43FF2BD8AD285062A965ADF55EEF6081E2EAA @AMOUNT @TOKENID TRUE)
ENDIF IF op EQ 21 THEN
ASSERT SIGNEDBY(PREVSTATE(125))
ASSERT SAMESTATE(120 128)
ASSERT STATE(129) GTE @BLOCK-20
ASSERT STATE(129) LTE @BLOCK
RETURN VERIFYOUT(0 @ADDRESS @AMOUNT @TOKENID TRUE)
ENDIF IF op EQ 22 THEN
ASSERT PREVSTATE(129) GT 0
ASSERT @BLOCK GT PREVSTATE(129)+20000
RETURN VERIFYOUT(0 PREVSTATE(126) @AMOUNT @TOKENID FALSE)
ENDIF IF op EQ 23 THEN
ASSERT SIGNEDBY(PREVSTATE(125))
LET r=PREVSTATE(124)
ASSERT r LT 4
ASSERT STATE(124) EQ r+1
ASSERT SAMESTATE(125 128)
ASSERT STATE(129) EQ 0
LET k=0
WHILE k LT r DO
ASSERT SAMESTATE(120+k 120+k)
LET k=k+1
ENDWHILE ASSERT STATE(120+r) NEQ 0x00
RETURN VERIFYOUT(0 @ADDRESS @AMOUNT @TOKENID TRUE)
ENDIF IF op EQ 24 THEN
ASSERT @COINAGE GT 700000
RETURN VERIFYOUT(0 PREVSTATE(126) @AMOUNT @TOKENID FALSE)
ENDIF RETURN FALSE
