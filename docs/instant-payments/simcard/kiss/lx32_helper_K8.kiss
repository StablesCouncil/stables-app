// lx32_helper_K8.kiss
// Purpose: Labelled-XOR Lamport (n=32) helper: verifies 32 of the 256 positions of one hop signature
// State ports: reads 16k+0 (R_k), 16k+1 (C_k), 16k+2 (chunk digests) for hop k derived from @INPUT
// Measured: 428 instructions, success=true, parseok=true
// Node 1.0.45.15 (lab peer 9101), runscript dry run, 2026-09-27T15:22:00.576Z. Receipt: measure/receipts/lx32_helper_K8_in8.json
// Script size: 2001 characters. Comment-free body below (deploy form).

LET j=@INPUT-1
LET c=j%8
LET p=16*(FLOOR(j/8)+1)
LET o=c*1024
LET r=SUBSET(o o+1024 STATE(p))
LET q=SUBSET(o o+1024 STATE(p+1))
LET y=CONCAT(SHA2(SHA2(SUBSET(0 32 r))) SHA2(SHA2(SUBSET(32 64 r))) SHA2(SHA2(SUBSET(64 96 r))) SHA2(SHA2(SUBSET(96 128 r))) SHA2(SHA2(SUBSET(128 160 r))) SHA2(SHA2(SUBSET(160 192 r))) SHA2(SHA2(SUBSET(192 224 r))) SHA2(SHA2(SUBSET(224 256 r))) SHA2(SHA2(SUBSET(256 288 r))) SHA2(SHA2(SUBSET(288 320 r))) SHA2(SHA2(SUBSET(320 352 r))) SHA2(SHA2(SUBSET(352 384 r))) SHA2(SHA2(SUBSET(384 416 r))) SHA2(SHA2(SUBSET(416 448 r))) SHA2(SHA2(SUBSET(448 480 r))) SHA2(SHA2(SUBSET(480 512 r))) SHA2(SHA2(SUBSET(512 544 r))) SHA2(SHA2(SUBSET(544 576 r))) SHA2(SHA2(SUBSET(576 608 r))) SHA2(SHA2(SUBSET(608 640 r))) SHA2(SHA2(SUBSET(640 672 r))) SHA2(SHA2(SUBSET(672 704 r))) SHA2(SHA2(SUBSET(704 736 r))) SHA2(SHA2(SUBSET(736 768 r))) SHA2(SHA2(SUBSET(768 800 r))) SHA2(SHA2(SUBSET(800 832 r))) SHA2(SHA2(SUBSET(832 864 r))) SHA2(SHA2(SUBSET(864 896 r))) SHA2(SHA2(SUBSET(896 928 r))) SHA2(SHA2(SUBSET(928 960 r))) SHA2(SHA2(SUBSET(960 992 r))))
LET y=CONCAT(y SHA2(SHA2(SUBSET(992 1024 r))))
LET z=CONCAT(SHA2(SUBSET(0 32 q)) SHA2(SUBSET(32 64 q)) SHA2(SUBSET(64 96 q)) SHA2(SUBSET(96 128 q)) SHA2(SUBSET(128 160 q)) SHA2(SUBSET(160 192 q)) SHA2(SUBSET(192 224 q)) SHA2(SUBSET(224 256 q)) SHA2(SUBSET(256 288 q)) SHA2(SUBSET(288 320 q)) SHA2(SUBSET(320 352 q)) SHA2(SUBSET(352 384 q)) SHA2(SUBSET(384 416 q)) SHA2(SUBSET(416 448 q)) SHA2(SUBSET(448 480 q)) SHA2(SUBSET(480 512 q)) SHA2(SUBSET(512 544 q)) SHA2(SUBSET(544 576 q)) SHA2(SUBSET(576 608 q)) SHA2(SUBSET(608 640 q)) SHA2(SUBSET(640 672 q)) SHA2(SUBSET(672 704 q)) SHA2(SUBSET(704 736 q)) SHA2(SUBSET(736 768 q)) SHA2(SUBSET(768 800 q)) SHA2(SUBSET(800 832 q)) SHA2(SUBSET(832 864 q)) SHA2(SUBSET(864 896 q)) SHA2(SUBSET(896 928 q)) SHA2(SUBSET(928 960 q)) SHA2(SUBSET(960 992 q)))
LET z=CONCAT(z SHA2(SUBSET(992 1024 q)))
LET t=CONCAT(0x01 y) ^ CONCAT(0x00 z)
ASSERT SHA2(t) EQ SUBSET(c*32 c*32+32 STATE(p+2))
RETURN TRUE
