//   NEG_A_registration_not_at_input_0: 12!/7! -> valid=false (expected false)
//   NEG_A_registration_recreated_elsewhere: 88!/31 -> valid=false (expected false)
//   NEG_A_registration_recreated_without_state: 88!/31 -> valid=false (expected false)
//   NEG_A_registration_not_recreated: 78!/31 -> valid=false (expected false)
//   NEG_A_registration_dust_skimmed: 88!/31 -> valid=false (expected false)
//   NEG_A_extra_keepstate_output_at_vault: 78!/31! -> valid=false (expected false)
//   NEG_A_zero_amount: 34!/31 -> valid=false (expected false)
//   NEG_A_negative_amount: 34!/31 -> valid=false (expected false)
//   A_CLOSE_dust_to_owner: 29 -> valid=true (expected true)
//   A_CLOSE_after_10_years: 29 -> valid=true (expected true)
//   NEG_A_CLOSE_unsigned: 11! -> valid=false (expected false)
//   NEG_A_CLOSE_redirected: 29! -> valid=false (expected false)
//   NEG_A_CLOSE_with_vault_coins: 29/13! -> valid=false (expected false)
//   V_MERGE_3_coins: 39/39/39 -> valid=true (expected true)
//   V_MERGE_coins_10_years_old: 39/39 -> valid=true (expected true)
//   NEG_V_MERGE_skims: 39!/39! -> valid=false (expected false)
//   NEG_V_MERGE_skims_to_second_output: 25!/25! -> valid=false (expected false)
//   NEG_V_MERGE_output_keeps_state: 39!/39! -> valid=false (expected false)
//   NEG_V_MERGE_mixed_currency: 25!/21! -> valid=false (expected false)
//   NEG_V_op4_retire_after_dormancy_to_old_successor: 13!/13! -> valid=false (expected false)
//   NEG_V_op4_after_10_years_to_anyone: 13! -> valid=false (expected false)
//   NEG_V_withdraw_op_after_10_years_without_registration: 12! -> valid=false (expected false)
//   NEG_V_unknown_operation: 13! -> valid=false (expected false)
LET op=STATE(8)
IF op EQ 1 THEN
ASSERT GETINADDR(0) EQ 0x5337459E075F10B5340ACF645B7815D016570787ACBF632CD5ADBB19C8F45449
ASSERT @TOKENID EQ STATE(12)
LET c=STATE(10)
IF c GT 0 THEN
RETURN VERIFYOUT(1 @ADDRESS c @TOKENID FALSE)
ENDIF
RETURN c EQ 0
ENDIF
IF op EQ 3 THEN
ASSERT GETINADDR(0) EQ @ADDRESS
ASSERT GETINTOK(0) EQ @TOKENID
ASSERT @TOTOUT EQ 1
ASSERT STATE(10) EQ SUMINPUTS(@TOKENID)
RETURN VERIFYOUT(0 @ADDRESS STATE(10) @TOKENID FALSE)
ENDIF
RETURN FALSE
