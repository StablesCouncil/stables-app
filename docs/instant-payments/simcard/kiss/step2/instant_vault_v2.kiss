//   A_WITHDRAW_own_coin_added_goes_to_the_vault: 88/31 -> valid=true (expected true)
//   A_WITHDRAW_xWiniwa_via_Winiwa_dust_registration: 86/31 -> valid=true (expected true)
//   NEG_A_currency_swapped_in_state: 23!/31 -> valid=false (expected false)
//   A_WITHDRAW_large_amount_no_limit: 88/31 -> valid=true (expected true)
//   A_WITHDRAW_everything_5_coins_no_change: 93/28/28/28/28/28 -> valid=true (expected true)
//   A_WITHDRAW_coin_10_years_old: 93/28 -> valid=true (expected true)
//   A_WITHDRAW_reserved_ports_4_to_6_not_read: 88/31 -> valid=true (expected true)
//   DEMO_T3_C_withdraws_25_from_A_load_of_100: 88/31 -> valid=true (expected true)
//   DEMO_T5_B_withdraws_35_from_change_75: 88/31 -> valid=true (expected true)
//   DEMO_T6_A_withdraws_40_vault_to_zero: 93/28 -> valid=true (expected true)
//   NEG_DEMO_T6_A_registration_paying_C: 70!/28 -> valid=false (expected false)
//   NEG_A_unsigned: 11!/31 -> valid=false (expected false)
//   NEG_A_signed_by_another_key: 11!/31 -> valid=false (expected false)
//   NEG_A_payout_redirected_in_output: 70!/31 -> valid=false (expected false)
//   NEG_A_payout_redirected_in_state: 19!/31 -> valid=false (expected false)
//   NEG_A_key_swapped_in_state_signed_by_attacker: 11!/31 -> valid=false (expected false)
