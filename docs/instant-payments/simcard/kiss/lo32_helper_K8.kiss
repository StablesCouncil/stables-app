// lo32_helper_K8.kiss
// Purpose: Ordered (textbook) Lamport (n=32) helper: 32 positions, one IF per bit
// State ports: 16 R, 17 C, 18 chunk digests, 20 digest (BITGET order)
// Node 1.0.45.15 (lab peer 9101, RPC 9105), runscript dry run. Measurements (receipt = measure/receipts/<name>.json):
//   lo32_helper_K8_in1: 601 instructions, success=true (ordered Lamport hop 1 chunk 0 of 8)
// Script size: 4918 characters; state data in the measured call: 16672 bytes. Body below is comment-free (deploy form).

LET j=@INPUT-1
LET c=j%8
LET p=16*(FLOOR(j/8)+1)
LET o=c*1024
LET r=SUBSET(o o+1024 STATE(p))
LET q=SUBSET(o o+1024 STATE(p+1))
LET e=SUBSET(c*4 c*4+4 STATE(p+4))
IF BITGET(e 0) THEN
LET w=CONCAT(SUBSET(0 32 q) SHA2(SUBSET(0 32 r)))
ELSE LET w=CONCAT(SHA2(SUBSET(0 32 r)) SUBSET(0 32 q))
ENDIF IF BITGET(e 1) THEN
LET w=CONCAT(w SUBSET(32 64 q) SHA2(SUBSET(32 64 r)))
ELSE LET w=CONCAT(w SHA2(SUBSET(32 64 r)) SUBSET(32 64 q))
