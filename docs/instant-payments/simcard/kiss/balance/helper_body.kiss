// helper_body.kiss (chip-balance model, Phase 1 redo, docs/chip-balance-design.md)
// Purpose: LX16 chunk verifier (51 positions per helper, 5 helpers per signature), reached through MAST at the owner helper address; guarded by GETINTOK(0) EQ CHIP
// Ports: 16/17/18 LX16 R, C, chunk digests; 97 helper offset
// Measured: measure/receipts/balance_covenant_branches.json (node 1.0.45.15 jar in-process; templates and clean-invariance on the live node).
// Placeholders in the measured copy: CHIP / USDw token ids, BURN / SUCCESSOR addresses and the helper owner tag are random test values;
// VAULT, CHIPACC, VENDOR, DISP and the helper body hash are the real addresses of these exact texts.
// Measured branches:
//   helper_D1_first: 800 instructions, success=true (expected true)
//   helper_D1_last: 800 instructions, success=true (expected true)
//   NEG_helper_D1_tampered_complement: 798 instructions, success=false (expected false)
//   NEG_acc_D1_foreign_helper: 257 instructions, success=false (expected false)
//   NEG_acc_D1_helper_missing: 45 instructions, success=false (expected false)
//   NEG_helper_D1_tampered_secret: 798 instructions, success=false (expected false)
//   acc_D1_tampered_secret_passes_anchor_caught_by_helper: 432 instructions, success=true (expected true)

ASSERT GETINTOK(0) EQ 0xDEF4F22B26E6C2941C4157DEDB6165D5F34C51C7D45F2B225E0F939EC3BC7E23
LET j=@INPUT-STATE(97)
LET c=j%5
LET p=16*(FLOOR(j/5)+1)
LET o=c*816
LET r=SUBSET(o o+816 STATE(p))
LET q=SUBSET(o o+816 STATE(p+1))
LET y=CONCAT(SHA2(SUBSET(0 16 SHA2(SUBSET(0 16 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(16 32 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(32 48 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(48 64 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(64 80 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(80 96 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(96 112 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(112 128 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(128 144 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(144 160 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(160 176 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(176 192 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(192 208 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(208 224 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(224 240 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(240 256 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(256 272 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(272 288 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(288 304 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(304 320 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(320 336 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(336 352 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(352 368 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(368 384 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(384 400 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(400 416 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(416 432 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(432 448 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(448 464 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(464 480 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(480 496 r)))))
LET y=CONCAT(y SHA2(SUBSET(0 16 SHA2(SUBSET(496 512 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(512 528 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(528 544 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(544 560 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(560 576 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(576 592 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(592 608 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(608 624 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(624 640 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(640 656 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(656 672 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(672 688 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(688 704 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(704 720 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(720 736 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(736 752 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(752 768 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(768 784 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(784 800 r)))) SHA2(SUBSET(0 16 SHA2(SUBSET(800 816 r)))))
LET z=CONCAT(SHA2(SUBSET(0 16 q)) SHA2(SUBSET(16 32 q)) SHA2(SUBSET(32 48 q)) SHA2(SUBSET(48 64 q)) SHA2(SUBSET(64 80 q)) SHA2(SUBSET(80 96 q)) SHA2(SUBSET(96 112 q)) SHA2(SUBSET(112 128 q)) SHA2(SUBSET(128 144 q)) SHA2(SUBSET(144 160 q)) SHA2(SUBSET(160 176 q)) SHA2(SUBSET(176 192 q)) SHA2(SUBSET(192 208 q)) SHA2(SUBSET(208 224 q)) SHA2(SUBSET(224 240 q)) SHA2(SUBSET(240 256 q)) SHA2(SUBSET(256 272 q)) SHA2(SUBSET(272 288 q)) SHA2(SUBSET(288 304 q)) SHA2(SUBSET(304 320 q)) SHA2(SUBSET(320 336 q)) SHA2(SUBSET(336 352 q)) SHA2(SUBSET(352 368 q)) SHA2(SUBSET(368 384 q)) SHA2(SUBSET(384 400 q)) SHA2(SUBSET(400 416 q)) SHA2(SUBSET(416 432 q)) SHA2(SUBSET(432 448 q)) SHA2(SUBSET(448 464 q)) SHA2(SUBSET(464 480 q)) SHA2(SUBSET(480 496 q)))
LET z=CONCAT(z SHA2(SUBSET(496 512 q)) SHA2(SUBSET(512 528 q)) SHA2(SUBSET(528 544 q)) SHA2(SUBSET(544 560 q)) SHA2(SUBSET(560 576 q)) SHA2(SUBSET(576 592 q)) SHA2(SUBSET(592 608 q)) SHA2(SUBSET(608 624 q)) SHA2(SUBSET(624 640 q)) SHA2(SUBSET(640 656 q)) SHA2(SUBSET(656 672 q)) SHA2(SUBSET(672 688 q)) SHA2(SUBSET(688 704 q)) SHA2(SUBSET(704 720 q)) SHA2(SUBSET(720 736 q)) SHA2(SUBSET(736 752 q)) SHA2(SUBSET(752 768 q)) SHA2(SUBSET(768 784 q)) SHA2(SUBSET(784 800 q)) SHA2(SUBSET(800 816 q)))
LET t=CONCAT(0x01 y)^CONCAT(0x00 z)
ASSERT SHA2(t) EQ SUBSET(c*32 c*32+32 STATE(p+2))
RETURN TRUE
