// stamp_dispenser.kiss
// Stamp dispenser lanes: LOAD (issue marks), CLAIM1 (verify a victim chain, mint a voucher), MERGE, SPLIT.
// Measured: see measure/receipts/covenant-branches.json (node 1.0.45.15 jar, in-process) and templateChecks there.
// Placeholders used in the measured copy: STAMP/USDW token ids, BURN/NOTES/POOL addresses and the helper body hash are random test values.
//   lane_LOAD_3_notes: 203 instructions, success=true (expected true)
//   NEG_lane_LOAD_value_elsewhere: 54 instructions, success=false (expected false)
//   NEG_lane_LOAD_expiry_too_far: 30 instructions, success=false (expected false)
//   lane_MERGE_2: 67 instructions, success=true (expected true)
//   NEG_lane_MERGE_swallows_record: 47 instructions, success=false (expected false)
//   lane_SPLIT: 52 instructions, success=true (expected true)
//   C1_claim_verify_2hops_lane: 565 instructions, success=true (expected true)
//   C1_claim_verify_2hops_helper: 800 instructions, success=true (expected true)
//   NEG_C1_key_not_in_root: 516 instructions, success=false (expected false)
//   NEG_C1_voucher_redirected: 552 instructions, success=false (expected false)

ASSERT @AMOUNT GT 1
LET op=STATE(9)
IF op EQ 1 THEN
LET c=STATE(8)
ASSERT c GT 0
ASSERT STATE(99) EQ 1
ASSERT STATE(103) LTE @BLOCK+60000
LET i=0
WHILE i LT c DO
ASSERT VERIFYOUT(2*i 0xD40E26AA151812A352576B20FB81DAA332B071909ABF3D7B752A07524EC3F81F 1 @TOKENID TRUE)
ASSERT GETOUTADDR(2*i+1) EQ 0xD40E26AA151812A352576B20FB81DAA332B071909ABF3D7B752A07524EC3F81F
ASSERT GETOUTTOK(2*i+1) EQ 0xCA20F2505BF004D715DDBF8AA257647984F603B69691BEBFD922E88EBD95A063
ASSERT GETOUTAMT(2*i+1) GTE 1
ASSERT GETOUTKEEPSTATE(2*i+1)
LET i=i+1
ENDWHILE ASSERT @AMOUNT-c GT 1
RETURN VERIFYOUT(2*c @ADDRESS @AMOUNT-c @TOKENID FALSE)
ENDIF IF op EQ 3 THEN
ASSERT @INPUT EQ 0
ASSERT STATE(97) EQ 1
LET h=STATE(1)
ASSERT h GT 0
ASSERT h LTE 3
ASSERT @TOTIN EQ 1+5*h
LET jj=NUMBER(SUBSET(0 1 STATE(7)))
LET t=1
WHILE t LT h DO
ASSERT NUMBER(SUBSET(t t+1 STATE(7))) EQ jj+t
LET t=t+1
ENDWHILE LET aid=STATE(2)
LET pk=STATE(3)
LET prevd=STATE(4)
LET sum=0x00
LET pay=0x00
LET ha=ADDRESS([LET owner=]+STRING(STATE(6))+[ MAST 0x87D2386D6E247A82153098251A5847BC355C02D50B8AED4619E02BDADD87BEB4])
LET m=0x0000000000000000000000000000000100000000000000000000000000000002000000000000000000000000000000040000000000000000000000000000000800000000000000000000000000000010000000000000000000000000000000200000000000000000000000000000004000000000000000000000000000000080
LET zz=0x00000000000000000000000000000000
LET m=CONCAT(m SUBSET(1 128 m) SUBSET(0 1 zz))
LET m=CONCAT(m SUBSET(2 256 m) SUBSET(0 2 zz))
LET m=CONCAT(m SUBSET(4 512 m) SUBSET(0 4 zz))
LET m=CONCAT(m SUBSET(8 1024 m) SUBSET(0 8 zz))
LET m=CONCAT(m m)
LET m=SUBSET(0 4080 m)
IF h GTE 1 THEN
LET d=SHA2(CONCAT(0x01 aid SUBSET(0 1 STATE(7)) prevd STATE(19)))
ASSERT SHA2(CONCAT(0x01 STATE(18))) EQ pk
LET e=CONCAT(SUBSET(16 32 d) SUBSET(16 32 d))
LET f=CONCAT(SUBSET(0 16 d) SUBSET(0 16 d))
LET e=CONCAT(e e)
LET f=CONCAT(f f)
LET e=CONCAT(e e)
LET f=CONCAT(f f)
LET e=CONCAT(e e)
LET f=CONCAT(f f)
LET e=CONCAT(e e)
LET f=CONCAT(f f)
LET e=CONCAT(e e)
LET f=CONCAT(f f)
LET e=CONCAT(e e)
LET f=CONCAT(f f)
LET e=CONCAT(e f)
LET e=SUBSET(0 4080 e)
ASSERT (CONCAT(0x01 STATE(16))&CONCAT(0x01 m)) EQ (CONCAT(0x01 e)&CONCAT(0x01 m))
ASSERT GETINADDR(1+0) EQ ha
ASSERT GETINADDR(1+1) EQ ha
ASSERT GETINADDR(1+2) EQ ha
ASSERT GETINADDR(1+3) EQ ha
ASSERT GETINADDR(1+4) EQ ha
LET pk=SUBSET(0 32 STATE(19))
LET pay=SUBSET(32 64 STATE(19))
LET prevd=d
LET sum=CONCAT(sum d pk)
ENDIF IF h GTE 2 THEN
LET d=SHA2(CONCAT(0x01 aid SUBSET(1 2 STATE(7)) prevd STATE(35)))
ASSERT SHA2(CONCAT(0x01 STATE(34))) EQ pk
LET e=CONCAT(SUBSET(16 32 d) SUBSET(16 32 d))
LET f=CONCAT(SUBSET(0 16 d) SUBSET(0 16 d))
LET e=CONCAT(e e)
LET f=CONCAT(f f)
LET e=CONCAT(e e)
LET f=CONCAT(f f)
LET e=CONCAT(e e)
LET f=CONCAT(f f)
LET e=CONCAT(e e)
LET f=CONCAT(f f)
LET e=CONCAT(e e)
LET f=CONCAT(f f)
LET e=CONCAT(e e)
LET f=CONCAT(f f)
LET e=CONCAT(e f)
LET e=SUBSET(0 4080 e)
ASSERT (CONCAT(0x01 STATE(32))&CONCAT(0x01 m)) EQ (CONCAT(0x01 e)&CONCAT(0x01 m))
ASSERT GETINADDR(6+0) EQ ha
ASSERT GETINADDR(6+1) EQ ha
ASSERT GETINADDR(6+2) EQ ha
ASSERT GETINADDR(6+3) EQ ha
ASSERT GETINADDR(6+4) EQ ha
LET pk=SUBSET(0 32 STATE(35))
LET pay=SUBSET(32 64 STATE(35))
LET prevd=d
LET sum=CONCAT(sum d pk)
ENDIF IF h GTE 3 THEN
LET d=SHA2(CONCAT(0x01 aid SUBSET(2 3 STATE(7)) prevd STATE(51)))
ASSERT SHA2(CONCAT(0x01 STATE(50))) EQ pk
LET e=CONCAT(SUBSET(16 32 d) SUBSET(16 32 d))
LET f=CONCAT(SUBSET(0 16 d) SUBSET(0 16 d))
LET e=CONCAT(e e)
LET f=CONCAT(f f)
LET e=CONCAT(e e)
LET f=CONCAT(f f)
LET e=CONCAT(e e)
LET f=CONCAT(f f)
LET e=CONCAT(e e)
LET f=CONCAT(f f)
LET e=CONCAT(e e)
LET f=CONCAT(f f)
LET e=CONCAT(e e)
LET f=CONCAT(f f)
LET e=CONCAT(e f)
LET e=SUBSET(0 4080 e)
ASSERT (CONCAT(0x01 STATE(48))&CONCAT(0x01 m)) EQ (CONCAT(0x01 e)&CONCAT(0x01 m))
ASSERT GETINADDR(11+0) EQ ha
ASSERT GETINADDR(11+1) EQ ha
ASSERT GETINADDR(11+2) EQ ha
ASSERT GETINADDR(11+3) EQ ha
ASSERT GETINADDR(11+4) EQ ha
LET pk=SUBSET(0 32 STATE(51))
LET pay=SUBSET(32 64 STATE(51))
LET prevd=d
LET sum=CONCAT(sum d pk)
ENDIF ASSERT PROOF(STATE(3) 0 STATE(231) STATE(234) STATE(233))
LET s=CONCAT(STATE(2) SUBSET(0 1 STATE(7)) STATE(3) STATE(4) SUBSET(1 33 sum) pay STATE(231))
LET v=ADDRESS([LET h=]+STRING(SHA2(s))+[
LET rec=0xD40E26AA151812A352576B20FB81DAA332B071909ABF3D7B752A07524EC3F81F
LET s=STATE(230)
ASSERT SHA2(s) EQ h
ASSERT @INPUT EQ 0
ASSERT GETINADDR(1) EQ rec
LET r=STATE(200)
ASSERT SUBSET(0 32 r) EQ SUBSET(0 32 s)
LET j=NUMBER(SUBSET(32 33 s))
LET o=32+64*(j-1)
ASSERT SUBSET(o o+32 r) EQ SUBSET(33 65 s)
ASSERT SUBSET(o-32 o r) EQ SUBSET(65 97 s)
IF o+64 LT LEN(r) THEN
ASSERT SUBSET(o+32 o+64 r) NEQ SUBSET(97 129 s)
ENDIF ASSERT STATE(231) EQ SUBSET(161 193 s)
RETURN VERIFYOUT(0 0xCA777B9FD6F1E79EEE12D469E48FAB00AEC95CBDDB2508A88C89BAB0667062ED 1 @TOKENID FALSE)])
ASSERT VERIFYOUT(0 v 1 @TOKENID FALSE)
ASSERT @AMOUNT GT 2
RETURN VERIFYOUT(1 @ADDRESS @AMOUNT-1 @TOKENID FALSE)
ENDIF IF op EQ 40 THEN
LET i=0
WHILE i LT @TOTIN DO
ASSERT GETINADDR(i) EQ @ADDRESS
ASSERT GETINTOK(i) EQ @TOKENID
LET i=i+1
ENDWHILE RETURN VERIFYOUT(0 @ADDRESS SUMINPUTS(@TOKENID) @TOKENID FALSE)
ENDIF IF op EQ 41 THEN
LET a=STATE(8)
ASSERT a GT 1
ASSERT @AMOUNT-a GT 1
ASSERT VERIFYOUT(0 @ADDRESS a @TOKENID FALSE)
RETURN VERIFYOUT(1 @ADDRESS @AMOUNT-a @TOKENID FALSE)
ENDIF RETURN FALSE
